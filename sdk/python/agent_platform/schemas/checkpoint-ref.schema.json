{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:team6:schema:checkpoint-ref:v1",
  "title": "CheckpointRef",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "attemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "fence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[1-9][0-9]*$"
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stateSha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777216
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "id",
    "schemaVersion",
    "workspaceId",
    "runId",
    "attemptId",
    "fence",
    "parentId",
    "baseId",
    "stateSha256",
    "bytes",
    "createdAt"
  ]
}
