{
  "apiVersion": "agent-plugin.v2",
  "id": "example.python.target",
  "version": "1.0.0",
  "name": "Python A2A target",
  "description": "Returns a deterministic response for the A2A bridge smoke test.",
  "capabilities": ["example.a2a.target"],
  "tools": [],
  "inputSchema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": ["prompt"],
    "additionalProperties": false
  },
  "command": "uv",
  "args": ["run", "--no-sync", "--project", "agents", "python", "sdk/python/examples/a2a_target.py"]
}
