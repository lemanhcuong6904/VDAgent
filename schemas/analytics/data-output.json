{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-platform.internal/schemas/analytics/data-output.json",
  "title": "Data Preparation Output",
  "description": "Output schema for data preparation behavior",
  "type": "object",
  "properties": {
    "datasetId": {
      "type": "string",
      "pattern": "^ds_(?:[a-zA-Z0-9]{12}|[a-f0-9]{24})$",
      "description": "Persisted dataset identifier"
    },
    "tableName": {
      "type": "string",
      "description": "Name of the prepared table"
    },
    "error": {
      "type": "string",
      "description": "Error message if preparation failed"
    }
  },
  "additionalProperties": false
}
