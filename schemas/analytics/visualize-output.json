{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-platform.internal/schemas/analytics/visualize-output.json",
  "title": "Visualization Output",
  "description": "Output schema for visualization behavior",
  "type": "object",
  "properties": {
    "chartId": {
      "type": "string",
      "pattern": "^ch_[a-zA-Z0-9]{12}$",
      "description": "Persisted chart identifier"
    },
    "error": {
      "type": "string",
      "description": "Error message if visualization failed"
    }
  },
  "additionalProperties": false
}
