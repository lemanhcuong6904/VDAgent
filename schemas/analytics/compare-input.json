{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-platform.internal/schemas/analytics/compare-input.json",
  "title": "Comparison Analysis Input",
  "description": "Input schema for comparison behavior - identifies and executes comparison patterns",
  "type": "object",
  "required": ["prompt", "datasetId"],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "User request for comparison analysis"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^ds_(?:[a-zA-Z0-9]{12}|[a-f0-9]{24})$",
      "description": "Dataset identifier to compare"
    },
    "dataContext": {
      "type": "string",
      "maxLength": 2000,
      "description": "Context from data preparation step"
    }
  },
  "additionalProperties": false
}
