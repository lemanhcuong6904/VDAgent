{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-platform.internal/schemas/analytics/visualize-input.json",
  "title": "Visualization Input",
  "description": "Input schema for visualization behavior - creates charts and visual representations",
  "type": "object",
  "required": ["prompt", "datasetId"],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "User request for visualization"
    },
    "datasetId": {
      "type": "string",
      "pattern": "^ds_(?:[a-zA-Z0-9]{12}|[a-f0-9]{24})$",
      "description": "Dataset identifier to visualize"
    },
    "compareContext": {
      "type": "string",
      "maxLength": 2000,
      "description": "Context from comparison step"
    },
    "insightContext": {
      "type": "string",
      "maxLength": 2000,
      "description": "Context from insight step"
    }
  },
  "additionalProperties": false
}
