{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-platform.internal/schemas/analytics/report-output.json",
  "title": "Report Generation Output",
  "description": "Output schema for report behavior",
  "type": "object",
  "properties": {
    "reportId": {
      "type": "string",
      "pattern": "^rp_[a-zA-Z0-9]{12}$",
      "description": "Persisted report identifier"
    },
    "error": {
      "type": "string",
      "description": "Error message if report generation failed"
    }
  },
  "additionalProperties": false
}
