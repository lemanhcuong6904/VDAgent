            },
            "expiresAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "format": "date-time",
              "pattern": "Z$"
            },
            "runIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
