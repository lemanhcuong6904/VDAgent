        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "const": "peer",
              "maxLength": 16
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "expiresAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "format": "date-time",
              "pattern": "Z$"
            },
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": ["reason", "idempotencyKey", "expiresAt", "messageId"]
        }
      ]
