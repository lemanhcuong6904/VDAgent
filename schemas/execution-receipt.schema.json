{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:team6:schema:execution-receipt:v1",
  "title": "Execution receipt v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "receiptVersion": {
      "const": "execution.v1",
      "type": "string",
      "maxLength": 32
    },
    "kind": {
      "type": "string",
      "enum": ["gate", "milestone"]
    },
    "taskId": {
      "$ref": "#/$defs/id"
    },
    "baselineGitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "maxLength": 40
    },
    "worktreeStatus": {
      "type": "string",
      "maxLength": 65536
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "startedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "finishedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "arch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": ["node", "platform", "arch"]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pnpm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "python": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": ["pnpm", "python"]
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      },
      "maxItems": 256,
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "maxItems": 2048
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "maxItems": 4096
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 256
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "commandIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 256
        }
      },
      "required": ["status", "reason", "commandIds"]
    }
  },
  "required": [
    "receiptVersion",
    "kind",
    "taskId",
    "baselineGitSha",
    "worktreeStatus",
    "owner",
    "reviewer",
    "status",
    "startedAt",
    "finishedAt",
    "environment",
    "versions",
    "commands",
    "artifacts",
    "inputs",
    "limitations",
    "rollback"
  ],
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 32
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\\\)[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      },
      "required": ["path", "sha256", "bytes"]
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      },
      "required": ["passed", "failed", "skipped"]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 64,
          "minItems": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "exitCode": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        },
        "signal": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "finishedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "tests": {
          "anyOf": [
            {
              "$ref": "#/$defs/tests"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "id",
        "command",
        "status",
        "exitCode",
        "signal",
        "startedAt",
        "finishedAt",
        "output",
        "tests",
        "reason"
      ]
    }
  }
}
