# Data Agent plugin environment. Copy to agents/data/.env. Read by the plugin itself (never into os.environ).
# All LLM settings are optional: without them the agent still runs T1/T2 steps (semantic compiler, verified
# templates) with template summaries; T3 (free-text extra_needs), LLM summaries and free-text questions are off.

# Primary OpenAI-compatible endpoint (structured JSON output).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://…/v1
LLM_MODEL=

# Optional fallback provider; unset credentials default to the primary ones.
FALLBACK_LLM_MODEL=
FALLBACK_OPENAI_API_KEY=
FALLBACK_OPENAI_BASE_URL=

# Optional: timeout per LLM call, in seconds (default 120).
LLM_TIMEOUT_S=120

# Optional: reasoning effort sent to the model. Reasoning models (e.g. gpt-6-luna) accept temperature=0,
# which every structured call uses, only with "none".
# LLM_REASONING_EFFORT=none
