# data plugin environment. Copy to agents/data/.env and fill in the LLM settings.
# The plugin reads this file itself at Backend startup (never into os.environ); its values win over
# the Backend's process environment. Never committed, never copied into Docker images.

# Required: an OpenAI-compatible endpoint whose model supports tool calling.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://…/v1
LLM_MODEL=

# Optional: timeout per LLM call, in seconds (default 120).
LLM_TIMEOUT_S=120

# Optional: run without any LLM (StepSpec@1 requests only). Then the three settings above are not needed.
# DATA_LLM=off

# Optional: the Data agent narrates its own work in its chat pane (one step per phase, with the real tool calls).
# On by default; `off` returns to a single answer step.
# DATA_NARRATE=on
# Optional: let the LLM rephrase that narration (it only sees table names, row counts, codes and the original
# question, never row values; a sentence with a number or name that is not a fact is replaced by the template
# sentence). Used only when the LLM settings above are filled in. `off` keeps template sentences only.
# DATA_NARRATE_LLM=on

# Optional and only an expectation: the labels follow the warehouse the Backend reports serving (PostgreSQL → the DATA
# team's DW, SNAPSHOT_STATUS_ASSUMED; SQLite → the synthetic mock, SYNTHETIC_SOURCE). A value that disagrees is ignored
# with a warning.
# DATA_DW_PROFILE=
