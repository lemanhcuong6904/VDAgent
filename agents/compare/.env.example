# compare plugin environment. Copy to agents/compare/.env (gitignored) and fill in the key.
# The plugin reads this file itself at Backend startup (never into os.environ); its values win over
# the Backend's process environment. Never committed, never copied into Docker images.
#
# Everything is optional: without OPENAI_API_KEY the plugin still loads and answers with rules and
# templates. Numbers always come from the deterministic engine, never from the model.

# The model plans the comparison and words the answer (spec §1.9).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_FALLBACK_MODEL=gpt-4o-mini

# Seconds per model call (default 20); the whole turn keeps to 25 s.
LLM_TIMEOUT_S=20

# off = never call the model even when a key is set.
COMPARE_LLM=on

# Where the DATA team's VHOP CSV pack is (default: warehouse/vhop, var/vhop, data/vhop in the repo).
# VDAGENT_VHOP_DATA_DIR=
