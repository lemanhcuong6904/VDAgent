{
  "apiVersion": "agent-plugin.v2",
  "id": "insight",
  "version": "1.0.0",
  "name": "Insight",
  "description": "Explains trends and anomalies using evidence from datasets.",
  "capabilities": [
    "dataset.insight",
    "analytics"
  ],
  "requiredCapabilities": [],
  "acceptsDelegation": true,
  "tools": [
    "warehouse.describe_dataset",
    "warehouse.get_dataset_rows"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "required": [
      "prompt"
    ],
    "additionalProperties": false
  },
  "guardrails": [
    "Use only evidence available in the scoped tools and supplied prompt.",
    "Never expose secrets or claim an artifact that was not persisted."
  ],
  "outputSchema": {
    "type": "string"
  },
  "modelProfile": "default",
  "command": "uv",
  "args": [
    "run",
    "--no-sync",
    "--project",
    "agents",
    "python",
    "agents/insight.py"
  ]
}
