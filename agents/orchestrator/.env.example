# orchestrator plugin environment. Copy to agents/orchestrator/.env and fill in the LLM settings.
# The plugin reads this file itself at Backend startup (never into os.environ); its values win over
# the Backend's process environment. Never committed, never copied into Docker images.

# Required: an OpenAI-compatible endpoint whose model supports tool calling.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://…/v1
LLM_MODEL=

# Optional: timeout per LLM call, in seconds (default 120).
LLM_TIMEOUT_S=120

# Optional: plan without an LLM (deterministic classifier). Then the three settings above are not needed.
# ORCH_LLM=off

# Required for free-text questions: the snapshot and semantic version every run is pinned to. Never "latest".
# Uncomment and fill in: a value in this file wins over the process environment (docker compose sets them itself),
# and an empty value would erase them.
# The mock warehouse:                 SNAP-2026-09-28 / sc-1
# The real warehouse (Postgres gold): SNAP-20260630-01 / 3.1.0
# ORCH_SNAPSHOT_ID=SNAP-20260630-01
# ORCH_SEMANTIC_VERSION=3.1.0

# Optional: deadline of one whole run, in seconds (default 300).
# ORCH_DAG_TIMEOUT_S=300

# Debug only: use the old free-text tool loop instead of the LLM planner.
# ORCH_LEGACY_LOOP=off
