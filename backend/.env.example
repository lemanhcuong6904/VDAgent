# Backend environment (optional). Copy to backend/.env; every variable here is optional and
# overrides the matching key in backend/config.yaml. The process environment wins over this file.
# Relative paths resolve against the directory the backend is started from (the repo root for
# `make backend`). Not used by docker compose, which configures the backend with
# backend/config.compose.yaml.
#
# VDAGENT_CONFIG (which YAML file to load) must be set in the shell, not here: this file is found
# next to the config file, after the config path is chosen.

# MCP URL handed to agent plugins (their MCP clients connect to it); plugins run in this process,
# so the default points at this Backend.
# VDAGENT_MCP_PUBLIC_URL=http://localhost:8000/mcp

# SQLite files (create them with `make reset-db BACKEND_DB=… WAREHOUSE_DB=…`).
# VDAGENT_BACKEND_DB=./var/backend.db
# VDAGENT_WAREHOUSE_DB=./var/warehouse.db

# Built frontend served at /, if the directory exists.
# VDAGENT_FRONTEND_DIST=./frontend/dist

# Limits: agent-call depth, and assistant steps per turn (ctx.max_steps).
# VDAGENT_MAX_DEPTH=4
# VDAGENT_MAX_STEPS=12

# The real-estate DW the Data agent reads. Default: the SQLite mock (./var/re_warehouse.db).
# For the DATA team's real warehouse in PostgreSQL, restore warehouse/backup/*.dump, apply
# docker/warehouse/apply-views.sh (creates the read-only role `vdagent_reader`), then give the reader's DSN.
# Never commit a real password.
# VDAGENT_RE_WAREHOUSE_DB=postgresql://vdagent_reader:CHANGE_ME@localhost:5433/cdw

# Which development scopes data/seed_users.py grants: `demo` (default: PRJ-X / PRJ-Y of the mock)
# or `real` (projects 100, 200 and 400 of the real warehouse). Set it before seeding an empty database.
# VDAGENT_SCOPE_PROFILE=demo
