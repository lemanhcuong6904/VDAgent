PORT=3000
API_TOKEN=replace-with-a-long-local-token
PLATFORM_REQUIRE_SECURE_SECRETS=false
API_USER_ID=local-user
API_SPACE_ID=local-space
WEB_AUTH_MODE=demo
# Set WEB_AUTH_MODE=session and a long random secret before public deployment.
WEB_AUTH_SECRET=
WEB_SESSION_TTL_SECONDS=86400
WEB_ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Only set true when a trusted reverse proxy strips/replaces X-Forwarded-For.
TRUST_PROXY=false
POSTGRES_USER=team6
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=team6
DATABASE_URL=postgresql://team6:replace-with-a-long-database-password@database:5432/team6
AGENT_TOKEN_ORCHESTRATOR=replace-with-an-orchestrator-token
AGENT_TOKEN_DATA=replace-with-a-data-agent-token
AGENT_TOKEN_COMPARE=replace-with-a-compare-agent-token
AGENT_TOKEN_INSIGHT=replace-with-an-insight-agent-token
AGENT_TOKEN_VISUALIZE=replace-with-a-visualize-agent-token
AGENT_TOKEN_REPORT=replace-with-a-report-agent-token
# Docker sandbox is disabled in the production Compose profile because the
# Docker socket grants host-level control. Enable only in a separately trusted
# deployment with a dedicated supervisor and explicit socket group.
SANDBOX_PROVIDER=none
SANDBOX_IMAGE=node:24-slim
SANDBOX_MAX_CONCURRENT=2
SANDBOX_MAX_TIMEOUT_MS=300000
# Only a custom deployment that explicitly mounts /var/run/docker.sock needs
# this supplementary group. Inspect with `stat -c %g /var/run/docker.sock`.
DOCKER_GID=999

PI_DEFAULT_PROVIDER=openai
PI_DEFAULT_MODEL=gpt-4o-mini
# Optional JSON array of additional non-secret model profiles.
# MODEL_PROFILES_JSON=[{"id":"reasoning","provider":"anthropic","model":"claude-sonnet","capabilities":["reasoning","tool-calling"]}]
PI_DEFAULT_MODEL_PROFILE=default
MODEL_API_KEY=
TELEMETRY_MODE=
METRICS_ENABLED=true

# OTLP/Langfuse tracing (optional; empty = disabled, falls back to TELEMETRY_MODE above).
# Option A: point directly at any OTLP/HTTP traces receiver (e.g. the local otel-collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=replace-me
# Option B: Langfuse (derives the OTLP endpoint + Basic-auth header automatically).
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
# LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
OTEL_SERVICE_NAME=team6-cai
OTEL_SERVICE_VERSION=0.0.0
# Fraction of root traces sampled, 0..1.
OTEL_TRACES_SAMPLER_ARG=1

# Optional in-process TS agent modules (empty = none).
AGENT_PLUGIN_MODULES=
# Runtime resolves this to dist/tools/warehouse.js in the compiled image. Leave blank to
# use the environment-aware built-in default when running from source with pnpm dev.
AGENT_TOOL_MODULES=
# Maximum lifetime for agent notes (days); notes without an earlier expiry use this limit.
MEMORY_RETENTION_DAYS=365
MEMORY_AUDIT_RETENTION_DAYS=365
MEMORY_RETENTION_SWEEP_MS=3600000
# Production warehouse must be a separate PostgreSQL service, never the app database.
WAREHOUSE_DATABASE_URL=
WAREHOUSE_POSTGRES_ENABLED=false
WAREHOUSE_ALLOWED_TABLES=
# Empty = default Python roster in agents/manifests/*.json.
AGENT_EXTERNAL_MANIFESTS=
# Production external agents run under bubblewrap (private network/pid namespace,
# read-only image and private /tmp). Set empty outside production.
AGENT_ISOLATION_MODE=
PLATFORM_RUNNER_MODE=embedded
WORKER_ID=
WORKER_LEASE_MS=30000
WORKER_POLL_MS=250
WORKER_CONCURRENCY=4
OUTBOX_POLL_MS=250
# Optional JSON object of sender -> target agent IDs. Omit to use manifest/policy defaults.
AGENT_A2A_ALLOWED_EDGES=
