# VDaAgent — configuration for `make up`. Copy to .env (gitignored) and fill in the REQUIRED blocks.
# Every value here reaches all 6 agent plugins inside the container; nothing is baked into the image.

# ---- REQUIRED: an OpenAI-compatible endpoint (Orchestrator, Data and Report do not load without it) ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- REQUIRED: the real PostgreSQL warehouse (read through the `re` view layer as role vdagent_reader) --------
# postgresql://<user>:<password>@<host>:<port>/<database>, as seen FROM INSIDE Docker:
#   - PostgreSQL on this machine: host.docker.internal, and publish its port on the Docker bridge
#     (e.g. docker run … -p 172.17.0.1:5433:5432); 127.0.0.1/localhost is refused (it is the container itself)
#   - PostgreSQL elsewhere: its host name or IP
VDAGENT_RE_WAREHOUSE_DB=
# The snapshot every analysis is pinned to: must exist in re.snapshot_manifest as APPROVED with this semantic version
# (make up checks it). SNAP-20260630-01 / 3.1.0 is the DATA team's snapshot in warehouse/backup.
ORCH_SNAPSHOT_ID=SNAP-20260630-01
ORCH_SEMANTIC_VERSION=3.1.0

# ---- OPTIONAL -----------------------------------------------------------------------------------------------
# Insight narrates with Gemini first when this is set, else with the OpenAI key above.
# GEMINI_API_KEY=
# Host port for the UI and API (default 8000).
# VDAGENT_PORT=8000
