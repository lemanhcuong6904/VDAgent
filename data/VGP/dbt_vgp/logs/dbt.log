-- Trung vi gia thu cap + co ban ghi trong 90 ngay gan nhat tinh tu ky snapshot
-- moi nhat (2026-09-29) - xap xi dung chung cho ca 6 ky (gan giong Python,
-- vi dim_secondary_market_comps khong bien doi theo tung ky snapshot).

select
    project_id,
    unit_type,
    median(resale_price_per_m2_vnd) as secondary_median_ppm2,
    bool_or(date_diff('day', recorded_resale_date::date, date '2026-09-29') <= 90) as secondary_has_recent
from "vgp"."main_staging"."stg_dim_secondary_market_comps"
group by 1, 2
  );

